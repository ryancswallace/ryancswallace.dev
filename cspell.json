{
    "version": "0.2",
    "language": "en",
    "useGitignore": true,
    "ignorePaths": [
        ".git/**",
        ".vscode/**",
        "build/**",
        "cspell.json",
        "dist/**",
        "htmlcov/**",
        "node_modules/**",
        "package-lock.json"
    ],
    "ignoreRegExpList": [
        "color: .*"
    ],
    "words": [
        "autoplay",
        "backurl",
        "bradlc",
        "cspell",
        "daemonless",
        "davidanson",
        "dbaeumer",
        "deptry",
        "esbenp",
        "favicons",
        "frontmatter",
        "headshot",
        "htmlcov",
        "inspectable",
        "Jobman",
        "mikestead",
        "minmax",
        "mktemp",
        "nohup",
        "noncommutative",
        "pagefind",
        "processless",
        "pytest",
        "Rscript",
        "ryancswallace",
        "seccomp",
        "Stata",
        "vivaxy",
        "withastro",
        "Zizmor"
    ]
}
