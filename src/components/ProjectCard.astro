---
import type { Project } from "@/data/projects";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";

export interface Props {
  project: Project;
}

const { project } = Astro.props;
const [primaryLink, ...supportingLinks] = project.links;
---

<article
  class:list={[
    "group flex h-full flex-col rounded-xl border border-border bg-background p-5 transition-colors hover:border-accent/70 sm:p-6",
    { "lg:col-span-2": project.featured },
  ]}
>
  <div class="mb-5 flex items-center justify-between gap-4 font-mono">
    <span class="text-xs font-semibold tracking-[0.16em] text-accent uppercase">
      {project.category}
    </span>
    <span class="text-xs text-foreground/70" aria-hidden="true">
      {project.index}
    </span>
  </div>

  <div
    class:list={[
      { "lg:grid lg:grid-cols-[1.15fr_0.85fr] lg:gap-10": project.featured },
    ]}
  >
    <div>
      <h3 class="text-xl font-semibold tracking-tight sm:text-2xl">
        <a
          href={project.titleHref ?? primaryLink.href}
          class="decoration-dashed underline-offset-4 group-hover:text-accent hover:underline"
        >
          {project.name}
        </a>
      </h3>

      <p class="mt-3 text-[0.98rem] leading-7 text-foreground/85">
        {project.summary}
      </p>

      <div class="mt-5 border-s-2 border-accent/70 ps-3">
        <p
          class="font-mono text-xs font-semibold tracking-[0.12em] text-foreground/70 uppercase"
        >
          Engineering focus
        </p>
        <p class="mt-2 text-sm leading-6 text-foreground/75">
          {project.significance}
        </p>
      </div>

      <ul
        class="mt-5 flex flex-wrap gap-2"
        aria-label={project.name + " technologies"}
      >
        {
          project.technologies.map(technology => (
            <li class="rounded-full border border-border bg-muted/35 px-2.5 py-1 font-mono text-xs">
              {technology}
            </li>
          ))
        }
      </ul>
    </div>

    {
      project.components && (
        <div class="mt-8 border-t border-dashed border-border pt-6 lg:mt-0 lg:border-s lg:border-t-0 lg:ps-8 lg:pt-0">
          <p class="font-mono text-xs font-semibold tracking-[0.12em] text-foreground/70 uppercase">
            Components
          </p>
          <ul class="mt-3 divide-y divide-border">
            {project.components.map(component => (
              <li class="py-3 first:pt-0 last:pb-0">
                <a
                  href={component.href}
                  class="group/component grid grid-cols-[1fr_auto] gap-x-4"
                >
                  <span class="font-semibold group-hover/component:text-accent">
                    {component.name}
                  </span>
                  <IconArrowRight
                    class="mt-1 size-4 text-foreground/60 group-hover/component:text-accent"
                    aria-hidden="true"
                  />
                  <span class="mt-1 text-sm leading-6 text-foreground/70">
                    {component.summary}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </div>

  <div
    class="mt-auto flex flex-wrap items-center gap-x-4 gap-y-2 pt-6 font-mono text-sm"
  >
    <a
      href={primaryLink.href}
      class="inline-flex items-center gap-1 font-semibold text-accent decoration-dashed underline-offset-4 hover:underline"
    >
      {primaryLink.label}
      <IconArrowRight class="size-4" />
    </a>
    {
      supportingLinks.map(link => (
        <a
          href={link.href}
          class="text-foreground/70 decoration-dashed underline-offset-4 hover:text-accent hover:underline"
        >
          {link.label}
        </a>
      ))
    }
  </div>
</article>
