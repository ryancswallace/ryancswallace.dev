---
import Hr from "./Hr.astro";
import Socials from "./Socials.astro";

const currentYear = new Date().getFullYear();

export interface Props {
  noMarginTop?: boolean;
}

const { noMarginTop = false } = Astro.props;
---

<footer
  class:list={["w-full max-w-site font-mono", { "mt-auto": !noMarginTop }]}
>
  <Hr noPadding />
  <div
    class="grid gap-x-8 gap-y-0 py-7 sm:grid-cols-[1fr_auto] sm:items-start sm:py-6"
  >
    <nav
      aria-label="Footer navigation"
      class="flex flex-wrap gap-x-5 gap-y-2 text-sm sm:col-start-1 sm:row-start-1"
    >
      <a href="/#selected-work" class="hover:text-accent">Work</a>
      <a href="/posts/" class="hover:text-accent">Writing</a>
      <a href="/about/" class="hover:text-accent">About</a>
      <a href="https://resume.ryancswallace.dev" class="hover:text-accent">
        Résumé
      </a>
    </nav>

    <div
      class="mt-4 w-fit justify-self-start sm:col-start-2 sm:row-start-1 sm:mt-0 sm:justify-self-end"
    >
      <Socials centered exclude={["Resume"]} />
    </div>

    <nav
      aria-label="Writing resources"
      class="mt-2 flex flex-wrap gap-x-4 gap-y-2 text-sm sm:col-start-1 sm:row-start-2"
    >
      <a href="/tags/" class="hover:text-accent">Tags</a>
      <a href="/rss.xml" class="hover:text-accent">RSS</a>
    </nav>

    <p
      class="mt-8 text-xs leading-5 text-foreground/60 sm:col-span-2 sm:row-start-3"
    >
      Copyright &#169; {currentYear} Ryan Wallace. Content: CC BY 4.0. Code: MIT.
    </p>
  </div>
</footer>
