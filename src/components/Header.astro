---
import Hr from "./Hr.astro";
import IconX from "@/assets/icons/IconX.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconArchive from "@/assets/icons/IconArchive.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import IconMenuDeep from "@/assets/icons/IconMenuDeep.svg";
import LinkButton from "./LinkButton.astro";
import { SITE } from "@/config";

const { pathname } = Astro.url;

const currentPath =
  pathname.endsWith("/") && pathname !== "/" ? pathname.slice(0, -1) : pathname;

const isActive = (path: string) => {
  if (path === "/") return currentPath === "/";

  const currentPathArray = currentPath.split("/").filter(p => p.trim());
  const pathArray = path.split("/").filter(p => p.trim());

  return currentPath === path || currentPathArray[0] === pathArray[0];
};
---

<header class="font-mono">
  <a
    id="skip-to-content"
    href="#main-content"
    class="absolute start-16 -top-full z-50 bg-background px-3 py-2 text-accent backdrop-blur-lg transition-all focus:top-4"
  >
    Skip to content
  </a>
  <div
    id="nav-container"
    class="mx-auto flex max-w-site items-center justify-between"
  >
    <div
      id="top-nav-wrap"
      class="relative flex w-full items-center justify-between bg-background px-4 py-4 sm:py-6"
    >
      <a
        href="/"
        class="py-1 text-xl leading-8 font-semibold whitespace-nowrap sm:text-2xl sm:leading-none"
      >
        {SITE.title}
      </a>

      <nav id="nav-menu" class="ms-2 flex items-center justify-end">
        <button
          id="menu-btn"
          class="focus-outline p-2 sm:hidden"
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="menu-items"
        >
          <IconX id="close-icon" class="hidden" />
          <IconMenuDeep id="menu-icon" />
        </button>

        <ul
          id="menu-items"
          class:list={[
            "absolute top-full right-4 z-50 mt-1 hidden w-60 grid-cols-2 gap-1 rounded-lg border border-border bg-background p-3 shadow-xl",
            "[&>li>a]:block [&>li>a]:rounded-md [&>li>a]:px-3 [&>li>a]:py-2.5 [&>li>a]:text-center [&>li>a]:text-sm [&>li>a]:font-medium [&>li>a]:hover:bg-muted/40 [&>li>a]:hover:text-accent",
            "sm:static sm:flex sm:w-auto sm:items-center sm:gap-x-3 sm:border-0 sm:bg-transparent sm:p-0 sm:shadow-none",
            "sm:[&>li>a]:px-2 sm:[&>li>a]:py-1",
          ]}
        >
          <li class="col-span-2 sm:col-span-1">
            <a
              href="/#selected-work"
              class:list={{ "active-nav": isActive("/") }}
              aria-current={isActive("/") ? "page" : undefined}
            >
              Work
            </a>
          </li>
          <li class="col-span-2 sm:col-span-1">
            <a
              href="/posts"
              class:list={{ "active-nav": isActive("/posts") }}
              aria-current={isActive("/posts") ? "page" : undefined}
            >
              Writing
            </a>
          </li>
          <li class="col-span-2 sm:col-span-1">
            <a
              href="/about"
              class:list={{ "active-nav": isActive("/about") }}
              aria-current={isActive("/about") ? "page" : undefined}
            >
              About
            </a>
          </li>
          <li class="col-span-2 sm:col-span-1">
            <a href="https://resume.ryancswallace.dev">Resume</a>
          </li>
          {
            SITE.showArchives && (
              <li class="col-span-2 sm:col-span-1">
                <LinkButton
                  href="/archives"
                  class:list={[
                    "focus-outline flex justify-center p-3 sm:p-1",
                    {
                      "active-nav [&>svg]:stroke-accent": isActive("/archives"),
                    },
                  ]}
                  ariaLabel="Archives"
                  ariaCurrent={isActive("/archives") ? "page" : undefined}
                  title="Archives"
                >
                  <IconArchive class="hidden sm:inline-block" />
                  <span class="sm:sr-only">Archives</span>
                </LinkButton>
              </li>
            )
          }
          <li class="col-span-1 flex items-center justify-center">
            <LinkButton
              href="/search"
              class:list={[
                "focus-outline flex p-3 sm:p-1",
                { "[&>svg]:stroke-accent": isActive("/search") },
              ]}
              ariaLabel="Search"
              ariaCurrent={isActive("/search") ? "page" : undefined}
              title="Search"
            >
              <IconSearch />
              <span class="sr-only">Search</span>
            </LinkButton>
          </li>
          {
            SITE.lightAndDarkMode && (
              <li class="col-span-1 flex items-center justify-center">
                <button
                  id="theme-btn"
                  class="focus-outline relative size-12 p-4 sm:size-8 hover:[&>svg]:stroke-accent"
                  title="Switch theme"
                  aria-label="Switch theme"
                  aria-live="polite"
                  aria-pressed="false"
                >
                  <IconMoon class="absolute top-[50%] left-[50%] -translate-[50%] scale-100 rotate-0 transition-all dark:scale-0 dark:-rotate-90" />
                  <IconSunHigh class="absolute top-[50%] left-[50%] -translate-[50%] scale-0 rotate-90 transition-all dark:scale-100 dark:rotate-0" />
                </button>
              </li>
            )
          }
        </ul>
      </nav>
    </div>
  </div>
  <Hr noPadding />
</header>

<script>
  function toggleNav() {
    const navMenu = document.querySelector<HTMLElement>("#nav-menu");
    const menuBtn = document.querySelector<HTMLButtonElement>("#menu-btn");
    const menuItems = document.querySelector<HTMLElement>("#menu-items");
    const menuIcon = document.querySelector("#menu-icon");
    const closeIcon = document.querySelector("#close-icon");

    if (!navMenu || !menuBtn || !menuItems || !menuIcon || !closeIcon) return;

    const setMenuState = (isOpen: boolean) => {
      menuBtn.setAttribute("aria-expanded", String(isOpen));
      menuBtn.setAttribute("aria-label", isOpen ? "Close menu" : "Open menu");
      menuItems.classList.toggle("hidden", !isOpen);
      menuItems.classList.toggle("grid", isOpen);
      menuIcon.classList.toggle("hidden", isOpen);
      closeIcon.classList.toggle("hidden", !isOpen);
    };

    menuBtn.addEventListener("click", () => {
      setMenuState(menuBtn.getAttribute("aria-expanded") !== "true");
    });

    menuItems.querySelectorAll("a").forEach(link => {
      link.addEventListener("click", () => setMenuState(false));
    });

    navMenu.addEventListener("keydown", event => {
      if (event.key !== "Escape") return;

      setMenuState(false);
      menuBtn.focus();
    });
  }

  toggleNav();
  document.addEventListener("astro:after-swap", toggleNav);
</script>
