---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import IconGitHub from "@/assets/icons/IconGitHub.svg";
import IconLinkedin from "@/assets/icons/IconLinkedin.svg";
import IconMail from "@/assets/icons/IconMail.svg";
import IconResume from "@/assets/icons/IconResume.svg";
import IconRss from "@/assets/icons/IconRss.svg";
import getSortedPosts from "@/utils/getSortedPosts";
import { PROJECTS } from "@/data/projects";

const posts = await getCollection("blog", ({ data }) => !data.draft);
const latestPosts = getSortedPosts(posts).slice(0, 3);

const pageTitle = "Ryan Wallace | Software & Machine Learning Engineer";
const pageDescription =
  "Software and machine learning engineer building reliable data and ML systems, developer tools, and infrastructure.";
---

<Layout title={pageTitle} description={pageDescription}>
  <Header />
  <main id="main-content" data-layout="index">
    <section
      id="hero"
      class="grid max-w-site gap-x-10 gap-y-8 pt-10 pb-14 sm:grid-cols-[11rem_minmax(0,1fr)] sm:items-center sm:pt-16 sm:pb-20"
    >
      <a
        href="/about"
        class="group block w-fit"
        aria-label="More about Ryan Wallace"
      >
        <img
          src="/images/ryan-headshot.jpeg"
          alt="Ryan Wallace"
          width="176"
          height="176"
          class="size-[9.9rem] rounded-xl border border-border object-cover grayscale-[15%] transition-all duration-300 group-hover:grayscale-0 sm:size-44"
        />
      </a>

      <div>
        <p
          class="mb-3 font-mono text-sm font-semibold tracking-[0.12em] text-accent uppercase"
        >
          Software and machine learning engineer
        </p>
        <h1
          class="max-w-3xl text-4xl leading-tight font-bold tracking-tight sm:text-5xl"
        >
          Ryan Wallace
        </h1>
        <p class="mt-4 max-w-3xl text-lg leading-8 text-foreground/80">
          I build reliable data and ML systems, developer tools, and
          infrastructure.
        </p>
        <p class="mt-4 font-mono text-sm text-foreground/70">Boston, MA</p>
      </div>

      <nav
        aria-label="Professional links"
        class="flex flex-wrap items-center gap-x-5 gap-y-3 font-mono text-sm sm:col-span-2"
      >
        <a
          href="https://resume.ryancswallace.dev"
          class="inline-flex items-center gap-2 rounded-md border border-border px-4 py-3 font-semibold text-foreground/70 transition-colors hover:border-accent hover:text-accent"
        >
          <IconResume
            class="size-4 shrink-0 fill-transparent stroke-current stroke-2"
            aria-hidden="true"
          />
          Resume
        </a>
        <a
          href="mailto:ryan@ryancswallace.dev"
          class="inline-flex items-center gap-2 rounded-md border border-border px-4 py-3 font-semibold text-foreground/70 transition-colors hover:border-accent hover:text-accent"
        >
          <IconMail
            class="size-4 shrink-0 fill-transparent stroke-current stroke-2"
            aria-hidden="true"
          />
          Email
        </a>
        <a
          href="https://github.com/ryancswallace"
          class="inline-flex items-center gap-2 rounded-md border border-border px-4 py-3 font-semibold text-foreground/70 transition-colors hover:border-accent hover:text-accent"
        >
          <IconGitHub
            class="size-4 shrink-0 fill-transparent stroke-current stroke-2"
            aria-hidden="true"
          />
          GitHub
        </a>
        <a
          href="https://www.linkedin.com/in/ryancswallace/"
          class="inline-flex items-center gap-2 rounded-md border border-border px-4 py-3 font-semibold text-foreground/70 transition-colors hover:border-accent hover:text-accent"
        >
          <IconLinkedin
            class="size-4 shrink-0 fill-transparent stroke-current stroke-2"
            aria-hidden="true"
          />
          LinkedIn
        </a>
      </nav>
    </section>

    <section
      id="selected-work"
      class="max-w-site border-t border-dashed py-14 sm:py-20"
    >
      <div class="mb-8 max-w-3xl">
        <h2 class="text-3xl font-semibold tracking-tight sm:text-4xl">
          Open source projects
        </h2>
        <p class="mt-4 max-w-2xl leading-7 text-foreground/70">
          Selected tools and systems I design, build, and maintain.
        </p>
      </div>

      <div class="grid gap-5 lg:grid-cols-2">
        {PROJECTS.map(project => <ProjectCard {project} />)}
      </div>
    </section>

    <section
      id="writing"
      class="max-w-site border-t border-dashed py-14 sm:py-20"
    >
      <div class="grid gap-8 lg:grid-cols-[0.8fr_2fr] lg:gap-16">
        <div>
          <h2 class="text-3xl font-semibold tracking-tight">Latest writing</h2>
          <p class="mt-4 leading-7 text-foreground/70">
            Architecture notes and technical deep dives on data systems,
            performance, machine learning, and developer tools.
          </p>
          <div class="mt-6 flex flex-wrap gap-4 font-mono text-sm">
            <a
              href="/posts/"
              class="inline-flex items-center gap-1 font-semibold text-accent decoration-dashed underline-offset-4 hover:underline"
            >
              All writing
              <IconArrowRight class="size-4" />
            </a>
            <a
              href="/rss.xml"
              class="inline-flex items-center gap-1 text-foreground/70 decoration-dashed underline-offset-4 hover:text-accent hover:underline"
            >
              <IconRss class="size-4" />
              RSS
            </a>
          </div>
        </div>

        <ul class="divide-y divide-dashed divide-border border-y border-dashed">
          {latestPosts.map(post => <Card variant="h3" {...post} compact />)}
        </ul>
      </div>
    </section>

    <section
      id="capabilities"
      class="max-w-site border-t border-dashed pt-14 pb-12 sm:pt-20 sm:pb-14"
    >
      <div class="grid gap-10 lg:grid-cols-[0.85fr_2fr] lg:gap-16">
        <div>
          <h2 class="text-3xl font-semibold tracking-tight">Technical focus</h2>
          <p class="mt-4 leading-7 text-foreground/70">
            Production-minded engineering across data, ML, and infrastructure.
          </p>
        </div>

        <div class="grid gap-8 sm:grid-cols-3">
          <article class="border-t-2 border-accent pt-4">
            <p class="font-mono text-xs text-foreground/70">01</p>
            <h3 class="mt-2 text-lg font-semibold">Data and ML systems</h3>
            <p class="mt-3 leading-7 text-foreground/70">
              I build data pipelines, model workflows, and evaluation systems
              with Spark, Airflow, SQL, and cloud infrastructure.
            </p>
          </article>
          <article class="border-t-2 border-accent pt-4">
            <p class="font-mono text-xs text-foreground/70">02</p>
            <h3 class="mt-2 text-lg font-semibold">Software engineering</h3>
            <p class="mt-3 leading-7 text-foreground/70">
              I design maintainable Python and Go software with typed
              interfaces, automated tests, and CI.
            </p>
          </article>
          <article class="border-t-2 border-accent pt-4">
            <p class="font-mono text-xs text-foreground/70">03</p>
            <h3 class="mt-2 text-lg font-semibold">
              Platform and developer tools
            </h3>
            <p class="mt-3 leading-7 text-foreground/70">
              I build tooling for long-running workloads, reproducible
              environments, observability, and release automation.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section class="max-w-site pt-0 pb-14 sm:pb-20">
      <div
        class="rounded-xl border border-border bg-muted/25 px-5 py-8 sm:flex sm:items-center sm:justify-between sm:gap-8 sm:px-8"
      >
        <div>
          <h2 class="text-2xl font-semibold tracking-tight">Get in touch</h2>
          <p class="mt-2 max-w-2xl leading-7 text-foreground/70">
            Reach out about software engineering or ML/AI engineering roles, or
            to discuss data systems and developer infrastructure.
          </p>
        </div>
        <a
          href="mailto:ryan@ryancswallace.dev"
          class="mt-5 inline-flex shrink-0 items-center gap-2 rounded-md border border-accent px-4 py-3 font-mono text-sm font-semibold text-accent hover:bg-accent hover:text-background sm:mt-0"
        >
          Email me
          <IconArrowRight class="size-4" />
        </a>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/");
    }
  });
</script>
